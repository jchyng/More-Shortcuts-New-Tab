{
  "manifest_version": 3,
  "name": "More Shortcuts New Tab",
  "version": "2.1.11",
  "default_locale": "en",
  "description": "Break Chrome's 10-shortcut limit. Add up to 30 shortcuts to your new tab page with a clean, customizable, and searchable dashboard.",
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "icons": {
    "16": "assets/icons/tab-icon-loading-16.png",
    "32": "assets/icons/tab-icon-loading-32.png",
    "48": "assets/icons/tab-icon-loading-48.png",
    "128": "assets/icons/icon128-white.png"
  },
  "action": {
    "default_title": "New Tab",
    "default_icon": {
      "16": "assets/icons/tab-icon-dark-v2-16.png",
      "32": "assets/icons/tab-icon-dark-v2-32.png",
      "48": "assets/icons/tab-icon-dark-v2-48.png",
      "128": "assets/icons/icon128-white.png"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "favicon", "search"],
  "host_permissions": ["<all_urls>"]
}
